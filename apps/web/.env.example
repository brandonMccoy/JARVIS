# Copy to apps/web/.env

# Must match JARVIS_TOKEN in apps/core/.env
VITE_JARVIS_TOKEN=dev-local

# Optional: Picovoice AccessKey (https://console.picovoice.ai). Enables the local "Jarvis" wake word.
# Without it, the always-listening mode uses the browser's speech recogniser to spot "Hey Jarvis".
VITE_PICOVOICE_ACCESS_KEY=
