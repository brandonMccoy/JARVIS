# Copy to apps/core/.env and fill in.

# Required. The browser never sees this key.
ANTHROPIC_API_KEY=

# Required only if your key is "identity-linked" (Anthropic Console shows it tied to
# your user rather than a single workspace). Find the workspace id under
# console.anthropic.com -> Settings -> Workspaces. Leave blank for workspace-scoped keys.
ANTHROPIC_WORKSPACE_ID=

# Optional. Without it J.A.R.V.I.S. speaks with the browser's own British voice.
ELEVENLABS_API_KEY=

# Optional. Shared secret between web and core. Must match VITE_JARVIS_TOKEN in apps/web/.env.
JARVIS_TOKEN=dev-local

# Optional. Where the SQLite database lives (default: apps/core/data).
# JARVIS_DATA_DIR=
